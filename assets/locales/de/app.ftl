online-import = Importieren
online-import-hint = { $title } herunterladen, prüfen und zu Meine Fälle hinzufügen.
online-imported = Importiert
online-imported-hint = Diese Datei ist in Meine Fälle.
online-update = Aktualisieren…
online-update-hint = Meine Fälle enthält eine andere Version dieses Falls.
online-update-confirm = { $title } in Meine Fälle durch die Version der Sammlung ersetzen?
online-update-yes = Ersetzen
online-update-no = Meine behalten
