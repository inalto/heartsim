            backscatter_db: (-150.0, Designed, "designed: air does not scatter"),
            scatter_density: (1.0, Designed, "designed: fully developed speckle"),
            scatter_mean: (0.0, Designed, "designed: no coherent part"),
            scatter_spread: (0.0, Designed, "designed: no scatter"),
            specularity: (1.0, Designed, "designed: Lambert-like (n = 1)"),
