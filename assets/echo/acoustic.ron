// Acoustic table of the echo simulator's grey image (brief B32, item 1; heartsim_echo::acoustic).
//
// One row per tissue label (heartsim_geometry::Label::name); every value is (value, status, source):
// Read = read on the source the research note cites (docs/research/echo-simulator.md 3.2), Unverified = the note marks
// it so, Designed = chosen for this model. Nothing here comes from the IT'IS database or from any echo recording.
// The reflection at a label change is ((Z2 - Z1)/(Z2 + Z1))^2 (Shams 2008); attenuation is two-way, 2 * alpha * f * depth.
(
    format_version: 1,
    speed_of_sound_m_s: (1540.0, Read, "research note 3.2: lambda = 1.54 mm / f(MHz)"),
    tgc_reference_db_cm_mhz: (0.5, Read, "Stanford RAD225 notes (research note 3.2), dB/cm/MHz: soft tissue 0.5 (the default compensation cancels it: designed choice)"),
    display_top_db: (-10.0, Designed, "designed: myocardium mid-grey at 0 dB gain"),
    speckle_lattice_mm: (0.15, Designed, "research note 3.4 (designed): hash of the rest position on a 0.15 mm lattice"),
    speckle_oversample: (1.5, Designed, "designed: the lattice read is at least 1.5 sample spacings (coarser octaves deeper), so the speckle rides with the tissue"),
    pulse_cycles: (2.0, Designed, "brief B32 / research note 3.4: a pulse of about two cycles"),
    aperture_mm: (20.0, Unverified, "research note 3.2: footprint about 2 cm (textbook value, unverified)"),
    beyond_focus_widening: (2.0, Designed, "designed: lateral resolution lambda * F# worsening beyond the focus (research note 3.2, unverified)"),
    reverberation_face_reflection: (0.5, Designed, "designed: share of the pleural echo the transducer face sends back each time"),
    reverberation_repeats: (5.0, Designed, "designed: A-lines drawn after the pleural line"),
    rows: {
        "outside": (
