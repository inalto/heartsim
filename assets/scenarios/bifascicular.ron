// Tier-0 rhythm preset (brief B11). Ranges in `expected` are textbook criteria, see
// docs/research/tier0-rhythm-criteria.md; engine parameters are re-derived from the sources in `notes`.
Scenario(
    format_version: 1,
    id: "bifascicular",
    title: "Bifascicular block (RBBB + LAFB)",
    description: "Right bundle-branch block plus left anterior fascicular block: rsR' in V1, QRS about 130 ms and axis about -75 degrees.",
    tier: Template,
    anatomy: "default",
    seed: 42,
    notes: Some("RBBB criteria plus left axis deviation -45 to -90 degrees. Only the left posterior fascicle still conducts, so further disease\n(PR prolongation, intermittent Mobitz II) warns of complete heart block - look for syncope.\nDifferential: LBBB (no rsR' in V1), RBBB with inferior MI.\n\nSources:\n- Surawicz B et al. AHA/ACCF/HRS recommendations for the standardization and interpretation of the ECG, part III: intraventricular conduction disturbances. Circulation 2009;119:e235-e240.\n- Kusumoto FM et al. 2018 ACC/AHA/HRS guideline on the evaluation and management of patients with bradycardia and cardiac conduction delay. Circulation 2019;140:e382-e482.\n- Goldberger AL, Goldberger ZD, Shvilkin A. Goldberger's Clinical Electrocardiography, 9th ed. Elsevier 2017."),
    confused_with: ["rbbb", "lafb", "lbbb"],
    expected: Some(ExpectedFindings(
        hr_bpm: (60.0, 100.0),
        pr_ms: Some((120.0, 200.0)),
        qrs_ms: Some((120.0, 170.0)),
        axis_deg: Some((-90.0, -45.0)),
    )),
    timing: TimingParams(
        sinus: SinusParams(rate_bpm: 72.0),
        his_purkinje: HisPurkinjeParams(
            rbb: BundleEdge(delay_ms: 30.0, blocked: true, block_above_rate_bpm: 0.0),
            laf: BundleEdge(delay_ms: 15.0, blocked: true, block_above_rate_bpm: 0.0),
        ),
    ),
)
