// Tier-0 rhythm preset (brief B11). Ranges in `expected` are textbook criteria, see
// docs/research/tier0-rhythm-criteria.md; engine parameters are re-derived from the sources in `notes`.
Scenario(
    format_version: 1,
    id: "sinus_normal",
    title: "Sinus rhythm, normal axis",
    description: "Healthy adult heart at 72 bpm: every P is followed by a narrow QRS after a normal PR interval.",
    tier: Eikonal,
    anatomy: "default",
    seed: 42,
    notes: Some("Each beat starts in the sinoatrial node: an upright P in I, II and aVF precedes every QRS.\nCriteria: rate 60-100 bpm, PR 120-200 ms, QRS < 110 ms, frontal axis -30 to +90 degrees.\nCheck the rate (300 / large squares), regularity, P before every QRS, then PR, QRS and axis.\n\nSources:\n- Goldberger AL, Goldberger ZD, Shvilkin A. Goldberger's Clinical Electrocardiography, 9th ed. Elsevier 2017.\n- Mason JW et al. Recommendations for the standardization and interpretation of the ECG, part II: diagnostic statement list. Circulation 2007;115:1325-1332.\n- Durrer D et al. Total excitation of the isolated human heart. Circulation 1970;41:899-912."),
    confused_with: ["sinus_tachy_130", "sinus_arrhythmia", "pac_frequent"],
    expected: Some(ExpectedFindings(
        hr_bpm: (60.0, 100.0),
        pr_ms: Some((120.0, 200.0)),
        qrs_ms: Some((70.0, 110.0)),
        axis_deg: Some((-30.0, 90.0)),
    )),
    timing: TimingParams(
        sinus: SinusParams(rate_bpm: 72.0),
    ),
)
