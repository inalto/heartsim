// Tier-0 rhythm preset. Ranges in `expected` are textbook criteria, see
// docs/research/tier0-rhythm-criteria.md; engine parameters are re-derived from the references.
Scenario(
    format_version: 1,
    id: "mi_lateral_evolved",
    title: "Evolved lateral infarction: Q waves and T inversion",
    description: "Hours to days after an obtuse marginal occlusion: Q waves and inverted T waves in I, aVL, V5 and V6.",
    tier: Template,
    anatomy: "default",
    seed: 42,
    notes: Some("The leads over the lateral wall are I, aVL, V5 and V6.\nA pathological Q wave (Fourth Universal Definition): in V2-V3, any Q of at least 0.02 s or a QS complex; elsewhere, Q of at least 0.03 s and 0.1 mV deep, in two contiguous leads. It marks a region of dead tissue that no longer gives electrical forces, so the leads over it see the opposite wall activating away from them.\nThe inverted T waves are deep and symmetric, in the same leads. In a patient, Q waves appear over hours and T waves invert as the ST segment settles, over hours to days; Q waves usually persist. Timing varies between patients.\nThis branch was picked for the lead group it shows. Which artery caused a lateral infarct cannot be read with certainty from the ECG. A left-sided accessory pathway can mimic a lateral Q wave."),
    confused_with: ["stemi_lateral", "wpw_left_lateral", "lbbb", "lpfb"],
    references: [
        "Thygesen K et al. Fourth universal definition of myocardial infarction (2018). Circulation 2018;138:e618-e651.",
        "Wagner GS et al. Recommendations for the standardization and interpretation of the electrocardiogram, part VI: acute ischemia/infarction. Circulation 2009;119:e262-e270.",
        "Byrne RA et al. 2023 ESC Guidelines for the management of acute coronary syndromes. Eur Heart J 2023;44:3720-3826.",
        "Goldberger AL, Goldberger ZD, Shvilkin A. Goldberger's Clinical Electrocardiography, 9th ed. Elsevier 2017 (ch. 8, 9).",
        "Burns E, Buttner R. Life in the Fast Lane ECG Library: pathological Q waves, myocardial infarction evolution, litfl.com/ecg-library.",
    ],
    expected: Some(ExpectedFindings(
        hr_bpm: (65.0, 95.0),
        pr_ms: Some((120.0, 200.0)),
        qrs_ms: None,
        axis_deg: None,
    )),
    timeline: [
        TimedAction(at: 0.0, action: Stenosis(branch: "OM evolving", severity: 1.0)),
    ],
    timing: TimingParams(
        sinus: SinusParams(rate_bpm: 75.0),
    ),
)
