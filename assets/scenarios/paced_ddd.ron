// Tier-0 rhythm preset (brief B11). Ranges in `expected` are textbook criteria, see
// docs/research/tier0-rhythm-criteria.md; engine parameters are re-derived from the sources in `notes`.
Scenario(
    format_version: 1,
    id: "paced_ddd",
    title: "DDD pacing, atrial tracking in complete heart block",
    description: "Complete AV block; a DDD pacemaker senses every sinus P (75 bpm) and paces the right ventricle after a 150 ms AV delay.",
    tier: Template,
    anatomy: "default",
    seed: 42,
    notes: Some("DDD: both chambers paced and sensed, dual response. Here the sinus node is faster than the lower rate, so the pacemaker tracks it:\nsensed P -> AV delay -> ventricular stimulus -> wide paced QRS. AV synchrony is restored. Above the upper tracking rate the device\nshows pacemaker Wenckebach; PVARP prevents tracking of retrograde P waves (pacemaker-mediated tachycardia).\nDifferential: sinus rhythm with LBBB (no spikes, PR independent of a programmed delay), VVI pacing (P dissociated).\n\nSources:\n- Bernstein AD et al. The revised NASPE/BPEG generic code for antibradycardia, adaptive-rate, and multisite pacing. PACE 2002;25:260-264.\n- Goldberger AL, Goldberger ZD, Shvilkin A. Goldberger's Clinical Electrocardiography, 9th ed. Elsevier 2017.\n- Burns E, Buttner R. Life in the Fast Lane ECG Library, litfl.com/ecg-library."),
    confused_with: ["paced_vvi", "lbbb", "sinus_normal"],
    expected: Some(ExpectedFindings(
        hr_bpm: (70.0, 80.0),
        pr_ms: Some((140.0, 220.0)),
        qrs_ms: Some((120.0, 200.0)),
        axis_deg: None,
    )),
    timing: TimingParams(
        sinus: SinusParams(rate_bpm: 75.0),
        av: AvParams(complete_block: true),
        escape: EscapeParams(junctional_bpm: 0.0, ventricular_bpm: 30.0),
        pacer: Some(PacerConfig(mode: Ddd, lower_rate_bpm: 60.0, upper_rate_bpm: 120.0, av_delay_ms: 150.0)),
    ),
)
