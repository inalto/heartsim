// Tier-0 rhythm preset (brief B18). Ranges in `expected` are textbook criteria, see
// docs/research/tier0-rhythm-criteria.md; engine parameters are re-derived from the references.
Scenario(
    format_version: 1,
    id: "axis_left_deviation",
    title: "Left axis deviation (isolated)",
    description: "Sinus rhythm at 72 bpm with the frontal QRS axis rotated to about -50 degrees: lead I positive, leads II and aVF negative; the QRS stays narrow.",
    tier: Template,
    anatomy: "default",
    seed: 42,
    notes: Some("Left axis deviation is a frontal axis between -30 and -90 degrees: lead I is positive and lead II (and aVF) predominantly negative. Causes: left anterior fascicular block, inferior myocardial infarction, left ventricular hypertrophy, pre-excitation, pacing from the apex, hyperkalaemia, and a high diaphragm or obesity. A mild shift can be a normal variant.\nFind the cause with the rest of the ECG: a QRS under 120 ms with qR in aVL and rS in II-III-aVF suggests fascicular block; Q waves in II, III, aVF an old inferior infarct.\nThis preset only rotates the heart's vector; see lafb for the conduction cause."),
    confused_with: ["lafb", "bifascicular", "paced_vvi", "inferior myocardial infarction"],
    references: [
        "Mason JW et al. Recommendations for the standardization and interpretation of the electrocardiogram, part II. Circulation 2007;115:1325-1332.",
        "Goldberger AL, Goldberger ZD, Shvilkin A. Goldberger's Clinical Electrocardiography, 9th ed. Elsevier 2017.",
        "Burns E, Buttner R. Life in the Fast Lane ECG Library: left axis deviation, litfl.com/ecg-library.",
    ],
    expected: Some(ExpectedFindings(
        hr_bpm: (60.0, 100.0),
        pr_ms: Some((120.0, 200.0)),
        qrs_ms: Some((70.0, 110.0)),
        axis_deg: Some((-90.0, -30.0)),
    )),
    timing: TimingParams(
        sinus: SinusParams(rate_bpm: 72.0),
    ),
    morphology: MorphologyOverrides(axis_shift_deg: -110.0),
)
