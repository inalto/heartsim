// Auscultation preset (brief B27): an ordinary ECG with the heart sounds of a valve, shunt or
// ventricular disorder. Timing rules and their sources are in docs/research/heart-sounds.md; every
// number of the sound model is documented in crates/heartsim-ecg/src/auscultation.rs.
Scenario(
    format_version: 1,
    id: "mitral_regurgitation",
    title: "Mitral regurgitation (holosystolic murmur)",
    description: "Sinus rhythm at 75 bpm with a leaking mitral valve: a blowing plateau murmur fills systole from S1 through A2.",
    tier: Template,
    anatomy: "default",
    seed: 42,
    notes: Some("When the mitral valve leaks, the left ventricle ejects into the left atrium from the start of contraction to the end of ejection, so the murmur is holosystolic: an even plateau from S1 to and through A2, best at the apex with the diaphragm.\nUnlike an ejection murmur, it hardly changes after a long cycle: after an extrasystole it stays about the same loudness, which is a classic bedside contrast with aortic stenosis.\nRadiation to the axilla is not modelled.\nDifferential: ventricular septal defect, tricuspid regurgitation, aortic stenosis, mitral valve prolapse.\nThe sounds are a synthesised model, not a recording: timing follows the cited sources, pitch and loudness are designed. The lane under the strip shows the trace; pick a slower speed to hear the intervals stretch."),
    confused_with: ["ventricular_septal_defect", "tricuspid_regurgitation", "aortic_stenosis_mild", "mitral_valve_prolapse"],
    references: [
        "MSD Manual Professional Version: Mitral regurgitation, msdmanuals.com.",
        "MSD Manual Professional Version: Cardiac auscultation (Approach to the cardiac patient), msdmanuals.com.",
        "Alpert. In: Walker HK, Hall WD, Hurst JW, eds. Clinical Methods, 3rd ed. Butterworths 1990, ch. 26 (NCBI Bookshelf NBK345).",
    ],
    expected: Some(ExpectedFindings(
        hr_bpm: (60.0, 100.0),
        pr_ms: Some((120.0, 200.0)),
        qrs_ms: Some((70.0, 110.0)),
        axis_deg: Some((-30.0, 90.0)),
        extra_sounds: Some([]),
        murmurs: Some([Holosystolic]),
        s2_split: Some(Physiological),
    )),
    auscultation: (lesions: [(MitralRegurgitation, Moderate)]),
    timing: TimingParams(
        sinus: SinusParams(rate_bpm: 75.0),
    ),
)
