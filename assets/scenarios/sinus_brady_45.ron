// Tier-0 rhythm preset (brief B11). Ranges in `expected` are textbook criteria, see
// docs/research/tier0-rhythm-criteria.md; engine parameters are re-derived from the sources in `notes`.
Scenario(
    format_version: 1,
    id: "sinus_brady_45",
    title: "Sinus bradycardia, 45 bpm",
    description: "Sinus rhythm at 45 bpm: normal P-QRS-T sequence with long, regular RR intervals.",
    tier: Template,
    anatomy: "default",
    seed: 42,
    notes: Some("Sinus rhythm below 60 bpm (guideline definition: < 50 bpm). Every P is sinus (upright in II) and conducted with a normal PR.\nCommon in athletes and during sleep; also beta-blockers, hypothyroidism, sick sinus syndrome.\nSubsidiary pacemakers (junction 40-60 bpm) stay suppressed only while the sinus is faster; here the junction is set to 38 bpm.\n\nSources:\n- Kusumoto FM et al. 2018 ACC/AHA/HRS guideline on the evaluation and management of patients with bradycardia and cardiac conduction delay. Circulation 2019;140:e382-e482.\n- Goldberger AL, Goldberger ZD, Shvilkin A. Goldberger's Clinical Electrocardiography, 9th ed. Elsevier 2017.\n- Burns E, Buttner R. Life in the Fast Lane ECG Library, litfl.com/ecg-library."),
    confused_with: ["sinus_arrest_junctional_escape", "sa_exit_block", "junctional_rhythm", "avb_2nd_mobitz2_3to1"],
    expected: Some(ExpectedFindings(
        hr_bpm: (40.0, 59.0),
        pr_ms: Some((120.0, 200.0)),
        qrs_ms: Some((70.0, 110.0)),
        axis_deg: Some((-30.0, 90.0)),
    )),
    timing: TimingParams(
        sinus: SinusParams(rate_bpm: 45.0),
        escape: EscapeParams(junctional_bpm: 38.0, ventricular_bpm: 25.0),
    ),
)
