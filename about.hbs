<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>HeartSim — third-party licences</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #1b2a41; }
  pre { white-space: pre-wrap; background: #f4f6f9; padding: 1rem; border-radius: 6px; }
  .used-by { columns: 2; }
</style>
</head>
<body>
<h1>HeartSim — third-party licences</h1>
<p>HeartSim is distributed under MIT OR Apache-2.0. It includes the open-source components listed below.</p>
<h2>Licences in use</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licence texts</h2>
{{#each licenses}}
<section id="{{id}}">
  <h3>{{name}}</h3>
  <h4>Used by</h4>
  <ul class="used-by">
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
